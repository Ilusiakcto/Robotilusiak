# ============================================================
# OpenArm VR Teleoperation - Environment Configuration
# ============================================================
# Copy this file to .env and update the values for your setup.
# 
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
# ============================================================

# ------------------------------------------------------------
# UDP RELAY CONFIGURATION (Kenya PC)
# ------------------------------------------------------------
# The UDP relay forwards VR data from Quest to Ireland robot

# Local interface to listen on (0.0.0.0 = all interfaces)
UDP_RELAY_LOCAL_HOST=0.0.0.0

# Local port to listen on (Quest VR app connects here)
UDP_RELAY_LOCAL_PORT=5006

# Ireland robot's Tailscale IP address
# Find this by running 'tailscale ip -4' on the Ireland PC
UDP_RELAY_REMOTE_HOST=100.82.113.60

# Port on Ireland robot (should match teleop_udp listening port)
UDP_RELAY_REMOTE_PORT=5006

# ------------------------------------------------------------
# TELEOP CONFIGURATION (Ireland PC)
# ------------------------------------------------------------
# These can also be set via command line arguments

# CAN interface for left arm
TELEOP_LEFT_CAN=can0

# CAN interface for right arm
TELEOP_RIGHT_CAN=can1

# Maximum joint velocity in rad/s (lower = smoother, higher = faster)
TELEOP_MAX_JOINT_VELOCITY=1.0

# Motor position gain (stiffness)
TELEOP_MOTOR_KP=35.0

# Motor damping gain
TELEOP_MOTOR_KD=1.0

# ------------------------------------------------------------
# NETWORK CONFIGURATION
# ------------------------------------------------------------
# Example Tailscale IPs (update with your actual IPs)

# Kenya PC Tailscale IP
KENYA_TAILSCALE_IP=100.85.255.15

# Ireland PC Tailscale IP  
IRELAND_TAILSCALE_IP=100.82.113.60

# Kenya PC local WiFi IP (for Quest VR app)
# Find this by running 'ipconfig' on Windows or 'ip addr' on Linux
KENYA_LOCAL_IP=192.168.1.129
